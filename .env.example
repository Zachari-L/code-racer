# Every variable the app reads (TECH-10). Copy to `.env` and fill in; never commit `.env`.

# PostgreSQL. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://postgres:password@localhost:5432/coderacer?schema=public"

# Signs Auth.js sessions, guest cookies and realtime tickets. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# OAuth apps (AUTH-01). Callback URLs: <site>/api/auth/callback/discord and .../github
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# HTTP port of the custom server (default 3000).
PORT=3000

# "true" behind a reverse proxy (Fly.io) so client IPs come from X-Forwarded-For /
# Fly-Client-IP. Leave "false" when the app is reached directly.
TRUST_PROXY="false"

# Room code attempts per IP per minute (SALLE-10). Default 10; e2e tests raise it.
ROOM_CODE_RATE_LIMIT=10
