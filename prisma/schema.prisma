// Prisma Schema for CodeRacer
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum RaceVisibility {
  PUBLIC
  SEMI_PUBLIC
  PRIVATE
}

enum RaceStatus {
  WAITING
  COUNTDOWN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum ParticipantRole {
  HOST
  PARTICIPANT
  SPECTATOR
}

enum BotDifficulty {
  EASY
  MEDIUM
  HARD
  IMPOSSIBLE
}

// --------------------------------------------------------
// Authentication & User Models (NextAuth v5 compatible)
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  hostedRaces   Race[]           @relation("HostedRaces")
  participants  Participant[]
  results       RaceResult[]
  stats         UserStats?
  badges        UserBadge[]

  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------------------------
// User Progression & Statistics
// --------------------------------------------------------

model UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalRaces         Int      @default(0)
  totalWins          Int      @default(0)
  bestWpm            Float    @default(0)
  averageWpm         Float    @default(0)
  averageAccuracy    Float    @default(0)
  totalPlayTimeSec   Int      @default(0)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  iconName    String
  users       UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// --------------------------------------------------------
// Race, Lobby & Realtime State
// --------------------------------------------------------

model Race {
  id                  String         @id @default(cuid())
  code                String         @unique // 6-digit access code for semi-public lobbies
  hostId              String
  visibility          RaceVisibility @default(SEMI_PUBLIC)
  status              RaceStatus     @default(WAITING)
  
  // Text configuration
  text                String         @db.Text
  textLanguage        String         @default("fr") // "fr" | "en"
  textCategory        String         @default("quotes") // "sentences", "code", "moliere", etc.
  strictMode          Boolean        @default(false) // true = must correct errors; false = penalty
  maxDurationSec      Int            @default(120)
  estimatedDifficulty String         @default("MEDIUM") // EASY, MEDIUM, HARD, EXPERT

  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  host                User           @relation("HostedRaces", fields: [hostId], references: [id])
  participants        Participant[]
  results             RaceResult[]

  @@index([code])
  @@index([status])
}

model Participant {
  id            String          @id @default(cuid())
  raceId        String
  userId        String?
  guestNickname String?
  role          ParticipantRole @default(PARTICIPANT)
  isBot         Boolean         @default(false)
  botDifficulty BotDifficulty?
  carColor      String          @default("azure") // azure, tangerine, magenta, teal
  
  // Realtime state tracking
  progress      Float           @default(0) // 0 to 100%
  currentWpm    Float           @default(0)
  isFinished    Boolean         @default(false)
  joinedAt      DateTime        @default(now())

  race          Race            @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  results       RaceResult[]

  @@index([raceId])
  @@index([userId])
}

model RaceResult {
  id            String   @id @default(cuid())
  raceId        String
  participantId String
  userId        String?
  nickname      String
  rank          Int
  wpm           Float
  rawWpm        Float
  accuracy      Float
  errorsCount   Int
  durationMs    Int
  heatmapData   Json?    // Key-value map of keyboard key error frequency
  createdAt     DateTime @default(now())

  race          Race        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([raceId])
  @@index([userId])
}

model TextSnippet {
  id         String   @id @default(cuid())
  title      String?
  content    String   @db.Text
  language   String   @default("fr") // "fr" | "en"
  category   String   // "code", "moliere", "quotes", "sentences"
  difficulty String   @default("MEDIUM") // "EASY", "MEDIUM", "HARD"
  wordCount  Int
  charCount  Int
  createdAt  DateTime @default(now())

  @@index([language, category, difficulty])
}
