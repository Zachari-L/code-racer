// CodeRacer data model. See docs/ARCHITECTURE.md for the diagram.
// Database: PostgreSQL. Schema changes go through `bun run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  PUBLIC
  CODE
  PRIVATE
}

enum RoomStatus {
  WAITING
  COUNTDOWN
  RACING
  RESULTS
  CLOSED
}

enum MemberRole {
  PARTICIPANT
  SPECTATOR
}

enum Complexity {
  EASY
  MEDIUM
  HARD
}

enum ResultStatus {
  FINISHED
  TIMEOUT
  ABANDONED
}

// --------------------------------------------------------
// Accounts
// --------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  /// Login name (credentials) or provider handle (OAuth). Unique.
  username     String   @unique
  /// Display pseudonym (AUTH-05). Falls back to `username`.
  displayName  String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts    Account[]
  avatar      UserAvatar?
  hostedRooms Room[]       @relation("RoomHost")
  membership  RoomMember?
  results     RaceResult[]
  badges      UserBadge[]
}

/// OAuth identity (Discord, GitHub) linked to a user.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Uploaded profile picture, already resized and re-encoded as WebP (AUTH-04).
model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  iconName    String
  users       UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// --------------------------------------------------------
// Rooms
// --------------------------------------------------------

model Room {
  id         String         @id @default(cuid())
  /// 6 characters without ambiguous 0/O/1/I/L (SALLE-02).
  code       String         @unique
  hostId     String
  visibility RoomVisibility
  status     RoomStatus     @default(WAITING)
  capacity   Int
  /// Full RoomConfig (src/lib/game/config.ts), validated with Zod.
  config     Json
  /// Copies of config fields used to filter the room explorer (JOIN-02).
  language   String
  complexity Complexity
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  closedAt   DateTime?

  host    User         @relation("RoomHost", fields: [hostId], references: [id])
  members RoomMember[]
  bans    RoomBan[]
  invites Invite[]
  races   Race[]

  @@index([visibility, status])
}

/// A person currently in a room. `userId` and `guestId` are each unique across
/// all rooms, so the database guarantees one room per person (SALLE-06).
model RoomMember {
  id       String     @id @default(cuid())
  roomId   String
  userId   String?    @unique
  guestId  String?    @unique
  nickname String
  role     MemberRole @default(PARTICIPANT)
  joinedAt DateTime   @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, joinedAt])
}

/// Someone the host expelled; they cannot join this room again (SALLE-07).
model RoomBan {
  id        String   @id @default(cuid())
  roomId    String
  userId    String?
  guestId   String?
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@unique([roomId, guestId])
}

/// Single-use invitation link (SALLE-04). The first person to open it binds
/// it to their identity and IP address.
model Invite {
  id            String    @id @default(cuid())
  roomId        String
  /// 128-bit random token, base64url.
  token         String    @unique
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  usedIp        String?
  usedByUserId  String?
  usedByGuestId String?
  usedByName    String?
  revokedAt     DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

// --------------------------------------------------------
// Races and results
// --------------------------------------------------------

/// One round played in a room (vocabulary: "course").
model Race {
  id        String    @id @default(cuid())
  roomId    String
  seed      Int
  /// RoomConfig snapshot at the start of the race.
  config    Json
  text      String    @db.Text
  passageId String?
  startedAt DateTime
  endedAt   DateTime?

  room    Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  passage TextPassage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  results RaceResult[]

  @@index([roomId])
}

/// Final line of a racer. Every racer is stored so the results page can be
/// shown again from the history (HIST-02); only signed-in users have a userId.
model RaceResult {
  id             String       @id @default(cuid())
  raceId         String
  userId         String?
  nickname       String
  isBot          Boolean      @default(false)
  botLevel       String?
  rank           Int
  status         ResultStatus
  wpm            Float
  rawWpm         Float
  accuracy       Float
  errorsCount    Int
  durationMs     Int
  /// Part of durationMs added for uncorrected errors (FREE mode).
  penaltyMs      Int          @default(0)
  progress       Float
  /// Bonus types received, in order.
  bonuses        Json
  /// [{ t: seconds since start, wpm }] sampled every second (RES-05).
  wpmSeries      Json
  /// Expected key -> times missed (keyboard heatmap, RES-03).
  missedKeys     Json
  isPersonalBest Boolean      @default(false)
  createdAt      DateTime     @default(now())

  race Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([raceId])
  @@index([userId, createdAt])
}

/// Corpus of real passages for coherent texts (CONF-03).
model TextPassage {
  id         String     @id
  language   String
  title      String
  author     String
  content    String     @db.Text
  complexity Complexity
  wordCount  Int
  createdAt  DateTime   @default(now())

  races Race[]

  @@index([language, complexity])
}
